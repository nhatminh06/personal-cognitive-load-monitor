FROM python:3.11.14-slim-bookworm@sha256:65a93d69fa75478d554f4ad27c85c1e69fa184956261b4301ebaf6dbb0a3543d

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

RUN groupadd --gid 10001 cogniflow \
    && useradd --uid 10001 --gid 10001 --no-create-home cogniflow
WORKDIR /app
COPY requirements-event-consumer.txt .
RUN apt-get update \
    && apt-get upgrade --yes \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir --requirement requirements-event-consumer.txt \
    && pip uninstall --yes pip setuptools wheel
COPY src/cogniflow_eventing src/cogniflow_eventing
COPY src/preprocessing_api/__init__.py src/preprocessing_api/__init__.py
COPY src/preprocessing_api/activity_events.py src/preprocessing_api/activity_events.py

USER 10001:10001
EXPOSE 8080
CMD ["uvicorn", "cogniflow_eventing.consumer:app", "--host", "0.0.0.0", "--port", "8080", "--no-access-log"]
