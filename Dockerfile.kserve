# syntax=docker/dockerfile:1.7
FROM ghcr.io/astral-sh/uv:0.10.0@sha256:78a7ff97cd27b7124a5f3c2aefe146170793c56a1e03321dd31a289f6d82a04f AS uv
FROM python:3.11.14-slim-bookworm@sha256:65a93d69fa75478d554f4ad27c85c1e69fa184956261b4301ebaf6dbb0a3543d AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    MODEL_PATH=/app/models/cognitive_load_model.skops \
    MODEL_PACKAGE_PATH=/app/models/model-package.json

WORKDIR /app
ARG MODEL_PACKAGE_DIR=build/model-package
COPY --from=uv /uv /uvx /bin/
COPY pyproject.toml uv.lock ./
COPY ${MODEL_PACKAGE_DIR}/cognitive_load_model.skops ./models/cognitive_load_model.skops
COPY ${MODEL_PACKAGE_DIR}/model-package.json ./models/model-package.json
RUN uv sync --frozen --extra kserve --no-dev --no-install-project \
    && python -m pip uninstall -y pip setuptools
ENV PATH="/app/.venv/bin:${PATH}"

COPY src ./src
COPY scripts/serve_engineering_model.py ./scripts/serve_engineering_model.py
RUN useradd --create-home --uid 10001 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8080
ENTRYPOINT ["python", "-m", "cogniflow_kserve.server"]
CMD ["--model_name", "cognitive-load-classifier", "--http_port", "8080"]
