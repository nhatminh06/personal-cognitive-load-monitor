project_id        = "your-gcp-project-id"
region            = "us-central1"
cluster_name      = "cognitive-load-gke"
node_locations    = ["us-central1-a", "us-central1-b"]
nodes_per_zone    = 1
machine_type      = "e2-standard-4"
github_repository = "nhatminh06/personal-cognitive-load-monitor"
# Set both only after the owner approves creating budget alerts.
# billing_account_id = "000000-000000-000000"
# project_number     = "123456789012"
master_authorized_networks = [
  {
    cidr_block   = "203.0.113.10/32" # Replace with your operator or VPN public CIDR.
    display_name = "operator"
  }
]
