# reports/evidently/*.html is a generated Evidently dashboard (a full bundled
# React app, minified JS/CSS inline) regenerated by scripts/generate_drift_report.py
# / the DVC drift_report stage. Without this, GitHub's language detector counts
# its ~4MB of embedded JS as raw HTML/JS bytes and misrepresents this as an
# HTML-majority repository instead of the Python project it actually is.
reports/evidently/*.html linguist-generated=true
reports/evidently/*.html linguist-vendored=true
