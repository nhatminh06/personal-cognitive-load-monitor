# syntax=docker/dockerfile:1.7
FROM artifacts AS artifacts
FROM ghcr.io/actions/actions-runner@sha256:0ce3288e48b012a83685998f683a2ae0cbd284fa722c090dda0af5443215cf30 AS deploy

USER root
COPY --from=artifacts /SHA256SUMS /tmp/inputs/SHA256SUMS
COPY --from=artifacts /bin/ /tmp/inputs/bin/
COPY --from=artifacts /google-cloud-cli.tar.gz /tmp/inputs/google-cloud-cli.tar.gz
RUN cd /tmp/inputs \
    && sha256sum -c SHA256SUMS \
    && test "$(dpkg --print-architecture)" = amd64 \
    && tar -xzf google-cloud-cli.tar.gz -C /opt \
    && install -o root -g root -m 0755 bin/cosign /usr/local/bin/cosign \
    && install -o root -g root -m 0755 bin/helm /usr/local/bin/helm \
    && install -o root -g root -m 0755 bin/kubectl /usr/local/bin/kubectl \
    && install -o root -g root -m 0755 bin/trivy /usr/local/bin/trivy \
    && ln -s /opt/google-cloud-sdk/bin/gcloud /usr/local/bin/gcloud \
    && cosign version | grep -F 'GitVersion:    v3.1.4' \
    && helm version --short | grep -E '^v4\.3\.2\+' \
    && kubectl version --client=true -o yaml | grep -F 'gitVersion: v1.35.10-cogniflow.1' \
    && trivy --version | grep -F 'Version: 0.76.2' \
    && test "$(cat /opt/google-cloud-sdk/VERSION)" = 594.0.0 \
    && rm -rf /opt/google-cloud-sdk/platform/bq \
        /opt/google-cloud-sdk/platform/gsutil \
        /opt/google-cloud-sdk/platform/bundledpythonunix/lib/python3.14/site-packages/pip \
        /opt/google-cloud-sdk/platform/bundledpythonunix/lib/python3.14/site-packages/pip-*.dist-info \
        /opt/google-cloud-sdk/platform/bundledpythonunix/lib/python3.14/site-packages/setuptools \
        /opt/google-cloud-sdk/platform/bundledpythonunix/lib/python3.14/site-packages/setuptools-*.dist-info \
        /opt/google-cloud-sdk/platform/bundledpythonunix/lib/python3.14/site-packages/wheel \
        /opt/google-cloud-sdk/platform/bundledpythonunix/lib/python3.14/site-packages/wheel-*.dist-info \
    && rm -f /opt/google-cloud-sdk/bin/bq /opt/google-cloud-sdk/bin/gcloud-crc32c \
        /opt/google-cloud-sdk/bin/gsutil \
    && rm -f /usr/bin/apt* /usr/bin/dpkg* \
    && rm -rf /tmp/inputs \
    && rm -f /usr/bin/containerd /usr/bin/containerd-shim-runc-v2 /usr/bin/ctr \
        /usr/bin/docker /usr/bin/docker-init /usr/bin/docker-proxy /usr/bin/dockerd \
        /usr/bin/runc /usr/bin/sudo /usr/local/lib/docker/cli-plugins/docker-buildx \
    && rm -rf /home/runner/externals/node20/lib/node_modules \
        /home/runner/externals/node24/lib/node_modules \
    && deluser runner sudo \
    && deluser runner docker
USER 1001:1001
