{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cogniflow-v01",
  "main": "src/entry.py",
  "compatibility_date": "2026-11-26",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": true},
  "d1_databases": [{
    "binding": "DB", "database_name": "cogniflow-v01",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "ratelimits": [
    {"name": "LOGIN_LIMIT", "namespace_id": "26112601", "simple": {"limit": 5, "period": 60}},
    {"name": "API_LIMIT", "namespace_id": "26112602", "simple": {"limit": 120, "period": 60}}
  ],
  "vars": {"PUBLIC_ORIGIN": "https://REPLACE.workers.dev", "OWNER_ID": "owner"},
  "observability": {"enabled": false}
}
