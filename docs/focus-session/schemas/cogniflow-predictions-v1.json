{
  "$defs": {
    "EffortBand": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ],
      "title": "EffortBand",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "behavioral_contract_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Behavioral Contract Version",
      "type": "string"
    },
    "class_probabilities": {
      "anyOf": [
        {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Class Probabilities"
    },
    "cv_available": {
      "title": "Cv Available",
      "type": "boolean"
    },
    "cv_contract_version": {
      "anyOf": [
        {
          "const": "1.0",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cv Contract Version"
    },
    "dataset_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dataset Sha256",
      "type": "string"
    },
    "effort_band": {
      "$ref": "#/$defs/EffortBand"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_time": {
      "format": "date-time",
      "title": "Event Time",
      "type": "string"
    },
    "event_type": {
      "const": "prediction.completed",
      "default": "prediction.completed",
      "title": "Event Type",
      "type": "string"
    },
    "feature_as_of": {
      "format": "date-time",
      "title": "Feature As Of",
      "type": "string"
    },
    "feature_cutoff": {
      "format": "date-time",
      "title": "Feature Cutoff",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "inference_latency_ms": {
      "maximum": 300000,
      "minimum": 0,
      "title": "Inference Latency Ms",
      "type": "number"
    },
    "inference_source": {
      "enum": [
        "local_model",
        "kserve"
      ],
      "title": "Inference Source",
      "type": "string"
    },
    "ingested_at": {
      "format": "date-time",
      "title": "Ingested At",
      "type": "string"
    },
    "label_window_ids_used": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Label Window Ids Used",
      "type": "array"
    },
    "model_name": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Model Name",
      "type": "string"
    },
    "model_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Model Sha256",
      "type": "string"
    },
    "model_version": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Model Version",
      "type": "string"
    },
    "predicted_effort_rating": {
      "maximum": 7,
      "minimum": 1,
      "title": "Predicted Effort Rating",
      "type": "number"
    },
    "prediction_id": {
      "format": "uuid",
      "title": "Prediction Id",
      "type": "string"
    },
    "producer_version": {
      "maxLength": 32,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "run_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Session Id",
      "type": "string"
    },
    "source": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Source",
      "type": "string"
    },
    "subject_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subject Id"
    },
    "target_name": {
      "const": "self_reported_effort",
      "default": "self_reported_effort",
      "title": "Target Name",
      "type": "string"
    },
    "window_end": {
      "format": "date-time",
      "title": "Window End",
      "type": "string"
    },
    "window_id": {
      "format": "uuid",
      "title": "Window Id",
      "type": "string"
    },
    "window_start": {
      "format": "date-time",
      "title": "Window Start",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "event_time",
    "ingested_at",
    "source",
    "producer_version",
    "idempotency_key",
    "window_id",
    "window_start",
    "window_end",
    "feature_cutoff",
    "predicted_effort_rating",
    "effort_band",
    "model_name",
    "model_version",
    "run_id",
    "model_sha256",
    "dataset_sha256",
    "cv_available",
    "feature_as_of",
    "inference_latency_ms",
    "inference_source"
  ],
  "title": "PredictionResultEvent",
  "type": "object"
}
