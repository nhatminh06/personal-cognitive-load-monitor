{
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_time": {
      "format": "date-time",
      "title": "Event Time",
      "type": "string"
    },
    "event_type": {
      "enum": [
        "session.started",
        "session.paused",
        "session.resumed",
        "session.completed",
        "session.cancelled"
      ],
      "title": "Event Type",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "ingested_at": {
      "format": "date-time",
      "title": "Ingested At",
      "type": "string"
    },
    "planned_duration_seconds": {
      "anyOf": [
        {
          "maximum": 28800,
          "minimum": 300,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Planned Duration Seconds"
    },
    "privacy_mode": {
      "enum": [
        "behavioral",
        "behavioral_cv"
      ],
      "title": "Privacy Mode",
      "type": "string"
    },
    "producer_version": {
      "maxLength": 32,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "session_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Session Id",
      "type": "string"
    },
    "session_kind": {
      "enum": [
        "programming",
        "study"
      ],
      "title": "Session Kind",
      "type": "string"
    },
    "source": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Source",
      "type": "string"
    },
    "subject_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subject Id"
    }
  },
  "required": [
    "session_id",
    "event_time",
    "ingested_at",
    "source",
    "producer_version",
    "idempotency_key",
    "event_type",
    "sequence",
    "session_kind",
    "privacy_mode"
  ],
  "title": "SessionLifecycleEvent",
  "type": "object"
}
